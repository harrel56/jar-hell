### analyzed count
GET {{url}}/api/v1/packages/count

> {%
  client.test("Response is 200", () => {
    client.assert(response.status === 200);
  });
  client.test("Returns a number", () => {
    client.assert(typeof response.body === 'number');
  });
%}

### latest analyzed
GET {{url}}/api/v1/packages/latest

> {%
  client.test("Response is 200", () => {
    client.assert(response.status === 200);
  });
  client.test("Returns an array", () => {
    client.assert(Array.isArray(response.body));
  });
%}
