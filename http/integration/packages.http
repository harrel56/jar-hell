### get all versions: dev.harrel:json-schema
GET {{url}}/api/v1/packages/dev.harrel:json-schema/versions

> {%
  client.test("Response is 200", () => {
    client.assert(response.status === 200);
  });
  client.test("Should be gzipped", () => {
    client.assert(response.headers.valueOf('Content-Encoding') === 'gzip');
  });
%}

### get all versions: unknown classifier
GET {{url}}/api/v1/packages/dev.harrel:json-schema/versions?classifier=natives-linux

> {%
  client.test("Response is 200", () => {
    client.assert(response.status === 200);
  });
  client.test("No entries", () => {
    client.assert(response.body.length === 0);
  });
%}

